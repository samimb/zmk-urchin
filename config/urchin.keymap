#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "corne_constants.h"
#include "keys_se.h"

#define DEF 0
#define LOW 1
#define RSE 2
#define ADJ 3
#define HS  4
#define GM  5

#define APK(X) RS(RG(RC(X))) 

&mt {
    tapping-term-ms = <TAP_TERM>;
    quick-tap-ms = <QUICK_TAP_TERM>;
    flavor = "balanced";
    require-prior-idle-ms = <COMBO_TIMEOUT>;
};

&lt {
    tapping-term-ms = <TAP_TERM>;
    quick-tap-ms = <QUICK_TAP_TERM>;
    flavor = "balanced";
    require-prior-idle-ms = <COMBO_TIMEOUT>;
};

/ {
  combos {
    #include "combos.dtsi"
  };
  behaviors {
    tog_gm_safe: toggle_gaming_safe {
      compatible = "zmk,behavior-macro";
      label = "TOGGLE_GAMING_SAFE";
      #binding-cells = <0>;
      bindings = <&tog GM>;
    };
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      label = "HOMEROW_MODS";
      #binding-cells = <2>;
      tapping-term-ms = <TAP_TERM>;
      quick-tap-ms = <QUICK_TAP_TERM>;
      flavor = "balanced";
      require-prior-idle-ms = <COMBO_TIMEOUT>;
      bindings = <&kp>, <&kp>;
    };
    braces: braces {
      compatible = "zmk,behavior-macro";
      label = "BRACES";
      #binding-cells = <0>;
      bindings = <&kp LS(RA(SE_N8))>, <&kp LS(RA(SE_N9))>, <&kp ESC>, <&kp I>;
    };
    parens: parens {
      compatible = "zmk,behavior-macro";
      label = "PARENS";
      #binding-cells = <0>;
      bindings = <&kp LS(SE_N8)>, <&kp LS(SE_N9)>, <&kp ESC>, <&kp I>;
    };
    brackets: brackets {
      compatible = "zmk,behavior-macro";
      label = "BRACKETS";
      #binding-cells = <0>;
      bindings = <&kp RA(SE_N8)>, <&kp RA(SE_N9)>, <&kp ESC>, <&kp I>;
    };
    ds_apl: ds_apl {
      compatible = "zmk,behavior-macro";
      label = "APL";
      #binding-cells = <0>;
      bindings = <&kp DOT>, <&kp SPACE>;
    };
    qq1: tap_dance_1 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_1";
      #binding-cells = <0>;
      tapping-term-ms = <TAP_TERM>;
      bindings = <&kp SE_A_RING>, <&kp LS(SE_PLUS)>;
    };
    qq2: tap_dance_2 {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_2";
      #binding-cells = <0>;
      tapping-term-ms = <TAP_TERM>;
      bindings = <&kp LS(SE_N5)>, <&kp LS(SE_PLUS)>;
    };
    apl: tap_dance_apl {
      compatible = "zmk,behavior-tap-dance";
      label = "TAP_DANCE_APL";
      #binding-cells = <0>;
      tapping-term-ms = <TAP_TERM>;
      bindings = <&kp SPACE>, <&ds_apl>;
    };
    moto: behavior_mo_tog {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <TAP_TERM>;
      bindings = <&mo>, <&apl>;
    };
  };
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      label = "DEF";
      bindings = <
	  &kp Q        &kp W      &kp E         &kp R       &kp T             &kp Y        &kp U      &kp I        &kp O      &kp P           
	  &hm LSHIFT A &hm LALT S &hm LCTRL D   &hm LGUI F  &kp G             &kp H        &hm RGUI J &hm RCTRL K  &hm RALT L &hm RSHIFT BSLH 
	  &kp Z        &kp X      &kp C         &kp V       &kp B             &kp N        &kp M      &kp SE_COMMA &kp SE_DOT &kp SE_MINUS    
	                                        &lt LOW ESC &lt HS BSPC       &kp RET      &moto RSE 0
	>;
    };

    lower_layer {
      label = "LOW";
      bindings = <
	  &kp SE_N1         &kp SE_N2      &kp SE_N3       &kp SE_N4      &kp SE_N5           &kp SE_TILDE       &kp RBKT          &kp EQUAL         &kp SE_PLUS   &qq1           
	  &hm LSHIFT SE_N6  &hm LALT SE_N7 &hm LCTRL SE_N8 &hm LGUI SE_N9 &kp SE_N0           &kp RA(SE_N7)      &hm RGUI LS(RBKT) &hm RCTRL SE_PIPE &hm RALT SEMI &hm RSHIFT SQT 
	  &kp LS(RG(SE_N4)) &kp TAB        &parens         &braces        &brackets           &kp RA(LS(SE_N7))  &kp SE_GRAVE      &kp SE_TILDE      &kp SE_PIPE   &kp TILDE      
	                                                   &trans         &kp DEL             &kp RET            &lt ADJ SPACE
	>;
    };

    raise_layer {
      label = "RSE";
      bindings = <
	  &kp C_VOL_UP        &kp C_BRI_UP      &kp C_PREV       &kp C_PP          &kp UNDER            &kp LS(SE_N1) &kp LS(SE_N2)      &kp LS(SE_N3)       &kp LS(SE_N4)      &qq2                 
	  &hm LSHIFT C_VOL_DN &hm LALT C_BRI_DN &hm LCTRL C_NEXT &hm LGUI SE_TILDE &kp BSLH             &kp LS(SE_N6) &hm RGUI LS(SE_N7) &hm RCTRL LS(SE_N8) &hm RALT LS(SE_N9) &hm RSHIFT LS(SE_N0) 
	  &kp LS(SE_STAR)     &kp TAB           &kp LBRC         &kp RBRC          &kp RA(SE_N7)        &kp LEFT      &kp DOWN           &kp UP              &kp RIGHT          &kp LS(BSLH)         
                                                           &mo ADJ           &kp DEL              &kp RET       &kp SPACE
	>;
    };
    
    adjust_layer {
      label = "ADJ";
      bindings = <
          &trans       &trans       &trans        &trans       &trans             &kp F1  &kp F2  &kp F3  &kp F4  &kp F5   
	  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4       &kp F6  &kp F6  &kp F7  &kp F8  &kp F9   
	  &trans       &trans       &bt BT_CLR    &trans       &trans             &kp F9  &kp F10 &kp F11 &kp F12 &tog_gm_safe
	                                          &trans       &kp DEL            &kp RET &kp SPACE
        >;
    };

    hammerspoon_layer {
      label = "HS";
      bindings = <
	  &kp APK(Q) &kp APK(W) &kp APK(E) &kp APK(R)  &kp APK(T)        &kp APK(Y)    &kp APK(U)    &kp APK(I)  &kp APK(O)     &kp APK(P)
	  &kp APK(A) &kp APK(S) &kp APK(D) &kp APK(F)  &kp APK(G)        &kp APK(H)    &kp APK(J)    &kp APK(K)  &kp APK(L)     &tog DEF
	  &kp APK(Z) &kp APK(X) &kp APK(C) &kp APK(V)  &kp APK(B)        &kp APK(LEFT) &kp APK(DOWN) &kp APK(UP) &kp APK(RIGHT) &trans
	                                   &lt LOW ESC &lt HS BSPC       &kp RET       &moto RSE 0
	>;
    };

     gaming_layer {
       label = "GM";
       bindings = <
	   &kp Q &kp W &kp E &kp R       &kp T          &kp Y   &kp U &kp I        &kp O      &kp P           
	   &kp A &kp S &kp D &kp F       &kp G          &kp H   &kp J &kp K        &kp L      &kp BSLH 
	   &kp Z &kp X &kp C &kp V       &kp B          &kp N   &kp M &kp SE_COMMA &kp SE_DOT &kp SE_MINUS    
	                     &lt LOW ESC &lt HS BSPC    &kp RET &moto RSE 0
	 >;
     };
  };
};
